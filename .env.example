## Italy Legacy DB AI Bridge (template) - environment variables

# Database connection string (SQLAlchemy URL).
# SQLite (absolute path on Linux/WSL):
# ITALY_LEGACY_DB_URL=sqlite:////absolute/path/to/legacy.db
#
# SQL Server via ODBC:
# ITALY_LEGACY_DB_URL=mssql+pyodbc://user:password@server/DB?driver=ODBC+Driver+17+for+SQL+Server
#
# AS/400 / IBM i (ODBC driver required):
# ITALY_LEGACY_DB_URL=mssql+pyodbc://USER:PASSWORD@hostname/LIBRARY?driver=IBM+i+Access+ODBC+Driver
ITALY_LEGACY_DB_URL=

# Mapping file path (optional). Defaults to config/mapping.json.
# ITALY_LEGACY_MAPPING_PATH=/absolute/path/to/mapping.json

# Privacy auto-cleanup (optional). If enabled, closes connections and resets state after each query.
# ITALY_LEGACY_PRIVACY_AUTO_CLEANUP=1

